{
  "name": "climatestudio",
  "version": "1.1.0",
  "description": "ClimateStudio - Lectura de EPW y analisis bioclimatico (escritorio)",
  "author": "Universidad de San Buenaventura - Pasto",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "check:offline": "node scripts/check-offline.js",
    "predist": "npm run icon && npm run check:offline",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "co.edu.usb.climatestudio",
    "productName": "ClimateStudio",
    "copyright": "Universidad de San Buenaventura - Pasto",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "ClimateStudio.html",
      "package.json"
    ],
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ClimateStudio-${version}-portable.exe",
      "unicode": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ClimateStudio-${version}-setup.exe",
      "shortcutName": "ClimateStudio",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": true
    }
  }
}
